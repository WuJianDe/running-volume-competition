RewriteEngine On
RewriteBase /running-volume-competition/

# Route every API request to the PHP entry point. This also works when the
# server does not apply a nested api/.htaccess file.
RewriteRule ^api(?:/.*)?$ api/index.php [QSA,END]

# Serve existing static resources directly; route all Vue paths to index.html.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
